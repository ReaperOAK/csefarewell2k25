# Firebase web config is hardcoded in src/firebase.ts (public client keys — safe to ship).
# This file is committed, so DO NOT put real secrets here.

# Email backend. The browser calls /api/send-invite (same origin); that server route
# holds the token and forwards to the openclaw email-service. These are SERVER-ONLY
# (no NEXT_PUBLIC_ prefix) so they never reach the browser.
# Set the REAL values in Vercel project env (production) and in .env.local (local dev, gitignored).
EMAIL_API_URL=
EMAIL_API_TOKEN=
# (The invite link is derived server-side by email-service from its SITE_BASE_URL env.)
