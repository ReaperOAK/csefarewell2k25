# Copy to .env on the openclaw server and fill in. NEVER commit the real .env.

# The Gmail account you send FROM, and a Gmail APP PASSWORD (NOT your normal password).
# Create an app password at https://myaccount.google.com/apppasswords (requires 2-Step Verification).
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Shared secret the admin dashboard must send as `Authorization: Bearer <token>`.
# Generate one: openssl rand -hex 24
EMAIL_API_TOKEN=replace-with-a-long-random-token

# Requests now arrive from the Vercel server route (/api/send-invite), not browsers,
# so CORS origins usually don't matter. Leave empty to allow any origin (fine here).
ALLOWED_ORIGINS=

# Base URL of the public site, used to build invite links (/invitation/<id>).
# Set this to the Vercel URL once known, e.g. https://your-project.vercel.app
SITE_BASE_URL=https://your-project.vercel.app

# Display name on the From: header.
FROM_NAME=IBIZA — Farewell 2k26

# Local port the service listens on (Tailscale Funnel will forward to this).
PORT=8080
